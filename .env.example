LLM_PROVIDER=kimi
# Set LLM_FALLBACK=1 to automatically retry with the other provider on failure.
LLM_FALLBACK=0
# ── Anthropic Claude ──────────────────────────────────────────────────────────
# Required when LLM_PROVIDER=claude (or as fallback provider).
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ── Kimi (Moonshot AI) ────────────────────────────────────────────────────────
# Required when LLM_PROVIDER=kimi (or as fallback provider).
# Get your key at: https://platform.moonshot.cn/
MOONSHOT_API_KEY=your-Kimi-api-key-here
